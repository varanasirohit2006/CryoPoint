# Copy to .env. Credentials must never be committed.
JIT_GEMINI_API_KEY=
JIT_GEMINI_MODEL=gemini-3.5-flash-lite
JIT_GEMINI_RPM=12
JIT_OLLAMA_URL=http://127.0.0.1:11434
JIT_OLLAMA_MODEL=qwen3-vl:2b-instruct
JIT_OLLAMA_CONTEXT=4096
JIT_OLLAMA_MAX_OUTPUT_TOKENS=192
JIT_OLLAMA_IMAGE_MAX_WIDTH=960
JIT_BROWSER_HEADLESS=true
JIT_RUN_TIMEOUT_SECONDS=600
JIT_EMBEDDING_BACKEND=lexical
JIT_SIMILARITY_THRESHOLD=0.65
# The included demo credentials apply only to the local fixture portal.
JIT_FIXTURE_USERNAME=demo
JIT_FIXTURE_PASSWORD=demo-password
